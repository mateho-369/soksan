# SokSan Network — local stack configuration (docker compose)
# Copy to .env and adjust. Never commit real secrets.

# PostgreSQL (PostGIS image)
DB_DATABASE=soksan
DB_USERNAME=soksan
DB_PASSWORD=soksan-dev

# Laravel APP_KEY — leave empty to auto-generate on first container boot.
APP_KEY=

# Media storage: "public" for local dev, "r2" for Cloudflare R2 in production.
MEDIA_DISK=public

# Seed demo users + posts on first boot.
SEED_DEMO=true

# Redis — internal cache/counters/queues. The compose file keeps it on the
# private network only (no published port); never expose it publicly.
REDIS_MAXMEMORY=256mb
# Anonymous feed cache lifetime in seconds (safety net; writes invalidate
# cached pages immediately).
FEED_CACHE_TTL=60

# Production-only (Cloudflare R2) — keep empty locally.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=

# Frontend build-time variables (optional; see README + docs/DEPLOYMENT.md).
# The in-browser demo API is ON by default in `npm run dev` and OFF in
# production builds; VITE_USE_MOCK=true in a production build throws on
# boot (src/lib/runtime.ts).
# VITE_API_BASE_URL=/api/v1
# VITE_USE_MOCK=false
# VITE_DEV_PROXY=http://localhost:8000
