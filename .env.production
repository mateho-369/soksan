# SokSan frontend — PRODUCTION build environment.
#
# The in-browser demo API is a development tool and MUST stay disabled in
# production builds. src/lib/runtime.ts throws on boot if this is flipped
# to "true" for a production build.
VITE_USE_MOCK=false

# API base URL. The default same-origin value assumes the web server
# (nginx / Cloudflare) proxies /api/v1 to the Laravel API — see
# docs/DEPLOYMENT.md. Use an absolute https:// URL only when the API is
# served from a different origin.
VITE_API_BASE_URL=/api/v1
