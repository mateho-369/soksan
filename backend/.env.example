APP_NAME="SokSan API"
APP_ENV=local
# Generate per environment: php artisan key:generate (NEVER commit real keys)
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Origins allowed by CORS — the React user app (and later the admin site).
FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=

LOG_CHANNEL=stack
LOG_LEVEL=info

# PostgreSQL 16 + PostGIS
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=soksan
DB_USERNAME=soksan
DB_PASSWORD=change-me-in-production

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=sync

# Media storage: "public" for local dev, "r2" for Cloudflare R2.
MEDIA_DISK=public
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=soksan-media
R2_ENDPOINT=
R2_REGION=auto
R2_PUBLIC_URL=

SANCTUM_STATEFUL_DOMAINS=localhost:5173

# Google Places — used ONLY for the one-time business-registration confirm
# (PlacesService). Public maps render from OpenFreeMap / PMTiles, never Google.
GOOGLE_PLACES_API_KEY=

# Bakong KHQR billing (Phase 3). Leave empty locally: the demo seam issues
# sample invoices; set BAKONG_ALLOW_DEMO_CONFIRM=true to let the demo
# activate subscriptions without a real gateway.
BAKONG_API_KEY=
BAKONG_API_URL=https://api.bakong.gov.kh
BAKONG_MERCHANT_ID=
BAKONG_ALLOW_DEMO_CONFIRM=false
